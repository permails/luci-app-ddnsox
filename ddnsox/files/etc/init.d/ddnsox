#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/ddnsoxd

start_service() {
	local enabled
	config_load ddnsox
	config_get_bool enabled global enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance ddnsoxd
	procd_set_param command /usr/bin/ucode "$PROG"
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/ddnsoxd.pid
	procd_close_instance
}

reload_service() {
	if ubus list ddnsox >/dev/null 2>&1; then
		ubus call ddnsox reload >/dev/null 2>&1 && return 0
	fi
	restart
}

service_triggers() {
	procd_add_reload_trigger "ddnsox"
}
