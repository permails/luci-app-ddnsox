config global 'global'
	option enabled '1'
	option use_authoritative_ns '1'
	option check_interval '1800'
	option log_lines '300'
	option log_level 'info'
	list doh_servers 'https://223.5.5.5/dns-query'
	list doh_servers 'https://1.1.1.1/dns-query'
	list public_ip_urls_v4 'https://4.ipw.cn'
	list public_ip_urls_v4 'https://api4.ipify.org'
	list public_ip_urls_v6 'https://6.ipw.cn'
	list public_ip_urls_v6 'https://api6.ipify.org'

config rule 'myddns_ipv4'
	option enabled '0'
	option provider 'cloudflare.com-v4'
	option domain 'nas.example.com'
	option ip_mode 'ipv4'
	option username ''
	option password 'your_api_token'
	option interface 'auto'
	option ip_source 'auto'

config rule 'myddns_ipv6'
	option enabled '0'
	option provider 'aliyun.com'
	option domain 'home.example.com'
	option ip_mode 'ipv6'
	option username 'your_access_key_id'
	option password 'your_access_key_secret'
	option interface 'auto'
	option ip_source 'auto'
