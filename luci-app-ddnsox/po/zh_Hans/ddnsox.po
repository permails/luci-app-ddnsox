msgstr "Cloudflare 代理 (橙云)"

msgid "Allow Non-Public IPs"
msgstr "允许非公网 IP"

msgid "Special Environments: Proxy & Private DNS"
msgstr "特殊环境：代理与私有 DNS"

msgid "Optional overrides for restricted networks or internal enterprise DNS. Leave empty for standard broadband."
msgstr "仅用于受限网络或企业内网私有 DNS，普通宽带请留空。"

msgid "HTTP / SOCKS5 Proxy"
msgstr "HTTP / SOCKS5 代理"

msgid "Use when the router cannot reach overseas provider APIs (e.g. Cloudflare/Porkbun) directly. Only provider API updates use this proxy; WAN IP probing is unaffected."
msgstr "仅当路由器无法直连海外服务商 API（如 Cloudflare/Porkbun）时填写。仅代理更新请求，不影响本机公网 IP 探测。"

msgid "Custom Verification DNS"
msgstr "自定义校验 DNS"

msgid "Use for internal/private authoritative DNS (e.g. 10.0.0.53) or a custom DoH URL. Leave empty to use the global anti-poisoning DoH servers."
msgstr "仅用于企业内网私有权威 DNS（如 10.0.0.53）或自定义 DoH 地址；公网域名请留空以使用全局防污染 DoH。"

