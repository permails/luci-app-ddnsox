msgid "Event-driven updates + clean DoH verification"
msgstr "事件驱动更新 + 纯净 DoH 防污染校验"

msgid "Running"
msgstr "运行中"

msgid "Event-driven Dynamic DNS client with netifd interface tracking and DoH verification."
msgstr "基于 netifd 事件驱动与 DoH 防污染校验的现代化动态 DNS 客户端。"

msgid "Settings"
msgstr "设置"

msgid "Configure global event-driven probing, clean DoH verification servers, and log retention."
msgstr "配置全局事件驱动探测、纯净 DoH 校验服务器与日志保留策略。"

msgid "Service & Scheduling"
msgstr "服务与调度"

msgid "Control the ucode background daemon and safety-net fallback verification interval."
msgstr "控制 ucode 后台守护进程及兜底定时校验周期。"

msgid "Enable DDNSox Daemon"
msgstr "启用 DDNSox 守护进程"

msgid "Fallback Check Interval (s)"
msgstr "兜底校验间隔 (秒)"

msgid "Safety-net verification interval in addition to real-time netifd ubus events."
msgstr "除实时 netifd ubus 事件外的低频兜底校验周期。"

msgid "Anti-Poisoning DNS & WAN Probe"
msgstr "防污染 DNS 与公网探测"

msgid "Bypass local port 53 cache/fake-ip via DoH, and configure fallback public IP probe URLs for CGNAT WANs."
msgstr "通过 DoH 绕过本地 53 端口缓存或 fake-ip，并为 CGNAT 内网配置公网 IP 回退探测地址。"

msgid "Authoritative NS Fallback"
msgstr "权威 NS 回退"

msgid "Query the domain authoritative nameserver directly if DoH upstream servers fail."
msgstr "当 DoH 上游不可用时直接查询域名权威 NS 服务器。"

msgid "DoH Verification Servers"
msgstr "DoH 校验服务器"

msgid "Used to verify live DNS records without trusting local port 53 cache or fake-ip."
msgstr "用于校验真实线上 DNS 解析记录，避免受本地 53 端口缓存或 fake-ip 污染。"

msgid "Public IPv4 Probe URLs"
msgstr "公网 IPv4 探测地址"

msgid "Fallback endpoints when the WAN interface is behind CGNAT or private IPv4."
msgstr "当 WAN 口处于 CGNAT 或私网 IPv4 后时使用的公网回退探测接口。"

msgid "Public IPv6 Probe URLs"
msgstr "公网 IPv6 探测地址"

